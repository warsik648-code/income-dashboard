# Copy this file to .env and fill in real values.
# Never commit .env or .env.local.

# PostgreSQL connection string (Prisma CLI + app adapter)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/income_dashboard?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Set true behind reverse proxies / some hosts
AUTH_TRUST_HOST="true"

# One-time owner seed only (pnpm db:seed-owner). Remove password after seeding.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="replace-with-a-strong-password-at-least-12-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
