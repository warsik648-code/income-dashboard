# Copy this file to .env and fill in real values.
# Never commit .env or .env.local.

# PostgreSQL connection string (Prisma CLI + app adapter)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/income_dashboard?schema=public"

# Isolated integration-test database — prefer a separate file:
#   cp .env.integration.example .env.integration
# Put TEST_DATABASE_URL / TEST_DIRECT_URL there (not in this production .env).
# Then: pnpm db:migrate:test && pnpm test:integration

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Set true behind reverse proxies / some hosts
AUTH_TRUST_HOST="true"

# One-time owner seed only (pnpm db:seed-owner). Remove password after seeding.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="replace-with-a-strong-password-at-least-12-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Storage (private attachments bucket)
# Project URL is public; service role key is SERVER-ONLY (never NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_ATTACHMENTS_BUCKET="financial-attachments"
# Optional signed URL TTL in seconds (default 120)
SUPABASE_SIGNED_URL_TTL_SECONDS="120"

# Wallet Integrations (read-only public-address balance trackers)
# Never store seed phrases or private keys. All provider calls are server-side.
# TRONGRID_API_KEY="optional-trongrid-api-key"
# ETHEREUM_RPC_URL="https://your-ethereum-rpc.example"
# BLOCKCYPHER_TOKEN="optional-blockcypher-token"
