# Copy this file to .env and fill in real values.
# Never commit .env or .env.local.

# PostgreSQL connection string (Prisma CLI + app adapter)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/income_dashboard?schema=public"

# Isolated integration-test database (REQUIRED for DB integration tests).
# Never point this at production. Never reuse DATABASE_URL.
# Safety guard requires an explicit test marker, for example:
#   - database name containing "test" (recommended: income_dashboard_test)
#   - or ?integration_test=1 on the URL
#   - or INTEGRATION_TEST_DB_MARKER matching a unique substring of this URL
# Setup:
#   1. createdb income_dashboard_test
#   2. DATABASE_URL="$TEST_DATABASE_URL" pnpm exec prisma migrate deploy
#   3. pnpm test:integration
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/income_dashboard_test?schema=public"
# Optional extra marker if the DB name cannot contain "test":
# INTEGRATION_TEST_DB_MARKER="income_dashboard_test"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Set true behind reverse proxies / some hosts
AUTH_TRUST_HOST="true"

# One-time owner seed only (pnpm db:seed-owner). Remove password after seeding.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="replace-with-a-strong-password-at-least-12-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Storage (private attachments bucket)
# Project URL is public; service role key is SERVER-ONLY (never NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_ATTACHMENTS_BUCKET="financial-attachments"
# Optional signed URL TTL in seconds (default 120)
SUPABASE_SIGNED_URL_TTL_SECONDS="120"
