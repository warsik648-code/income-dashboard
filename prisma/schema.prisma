// Income Dashboard — Prisma schema
// Money fields use Decimal(19, 4). Amounts on Transaction are always positive;
// direction comes from TransactionType. Soft-delete via deletedAt.
// FX: amount/currency are ORIGINAL; baseAmountUsd is a frozen USD snapshot.
// exchangeRate = units of original currency per 1 USD (e.g. PKR per USD).
// baseAmountUsd = amount / exchangeRate (USD: rate 1, amount unchanged).
// Subscription renewals create expenses only when payment is confirmed (never on date alone).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  TRUST
  BINANCE
  BANK
  CASH
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  POS
  CASH
  BANK_TRANSFER
  CRYPTO_TRANSFER
  BINANCE
  TRUST
  OTHER
}

enum DebtDirection {
  LENT_OUT
  OWED_BY_ME
}

enum DebtStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  WRITTEN_OFF
}

enum AuditAction {
  CREATE
  UPDATE
  SOFT_DELETE
  RESTORE
}

enum AttachmentEntityType {
  TRANSACTION
  DEBT
  DEBT_PAYMENT
  SUBSCRIPTION
  TRANSFER
}

enum StorageProvider {
  LOCAL
  S3
  R2
  SUPABASE
}

enum BillingFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  TRIAL
  EXPIRED
}

enum ExchangeRateSource {
  MANUAL
  USER_OVERRIDE
  PROVIDER
  FIXED_USD
}

enum AssetClass {
  FIAT
  CRYPTO
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  passwordHash             String
  name                     String?
  preferredCurrency        String    @default("USD")
  timezone                 String    @default("UTC")
  dateFormat               String    @default("YYYY-MM-DD")
  numberFormat             String    @default("en-US")
  defaultIncomeAccountId   String?
  defaultExpenseAccountId  String?
  lastLoginAt              DateTime?
  passwordChangedAt        DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  defaultIncomeAccount  FinancialAccount?  @relation("DefaultIncomeAccount", fields: [defaultIncomeAccountId], references: [id], onDelete: SetNull)
  defaultExpenseAccount FinancialAccount?  @relation("DefaultExpenseAccount", fields: [defaultExpenseAccountId], references: [id], onDelete: SetNull)
  accounts              FinancialAccount[] @relation("UserAccounts")
  categories            Category[]
  transactions          Transaction[]
  debts                 Debt[]
  subscriptions         Subscription[]
  transfers             Transfer[]
  attachments           Attachment[]
  auditLogs             AuditLog[]

  @@index([defaultIncomeAccountId])
  @@index([defaultExpenseAccountId])
}

model FinancialAccount {
  id            String      @id @default(cuid())
  userId        String
  name          String
  type          AccountType
  currency      String
  assetClass    AssetClass  @default(FIAT)
  institution   String?
  notes         String?
  /// Native units: fiat money or crypto quantity (never mixed-currency sum)
  cachedBalance Decimal     @default(0) @db.Decimal(19, 4)
  isArchived    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  user                   User           @relation("UserAccounts", fields: [userId], references: [id])
  defaultIncomeForUsers  User[]         @relation("DefaultIncomeAccount")
  defaultExpenseForUsers User[]         @relation("DefaultExpenseAccount")
  transactions           Transaction[]
  debts                  Debt[]
  subscriptions          Subscription[]
  transfersFrom          Transfer[]     @relation("TransferFromAccount")
  transfersTo            Transfer[]     @relation("TransferToAccount")

  @@unique([userId, type, name])
  @@index([userId, deletedAt])
  @@index([userId, assetClass, deletedAt])
  @@index([userId, isArchived, deletedAt])
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  name      String
  kind      TransactionType
  isSystem  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  user          User           @relation(fields: [userId], references: [id])
  transactions  Transaction[]
  subscriptions Subscription[]

  @@unique([userId, kind, name])
  @@index([userId, kind, deletedAt])
}

model Transaction {
  id              String           @id @default(cuid())
  userId          String
  accountId       String
  categoryId      String?
  type            TransactionType
  /// ORIGINAL amount — never overwrite with USD
  amount          Decimal          @db.Decimal(19, 4)
  /// ORIGINAL currency / asset code
  currency        String
  /// Units of original currency per 1 USD (frozen at save)
  exchangeRate    Decimal          @db.Decimal(24, 12)
  /// Frozen USD snapshot: amount / exchangeRate
  baseAmountUsd   Decimal          @db.Decimal(19, 4)
  exchangeRateAt  DateTime
  exchangeRateSource ExchangeRateSource
  transactionDate DateTime
  description     String
  counterparty    String?
  paymentMethod   PaymentMethod?
  notes           String?
  debtId          String?
  subscriptionId  String?
  /// Links a Transfer Fees expense to its parent Transfer (principal is not a Transaction)
  transferId      String?
  /// UTC YYYY-MM-DD renewal period for subscription payments (DB-enforced unique)
  renewalPeriod   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  user         User             @relation(fields: [userId], references: [id])
  account      FinancialAccount @relation(fields: [accountId], references: [id])
  category     Category?        @relation(fields: [categoryId], references: [id])
  debt         Debt?            @relation(fields: [debtId], references: [id])
  subscription Subscription?    @relation(fields: [subscriptionId], references: [id])
  transfer     Transfer?        @relation(fields: [transferId], references: [id])
  debtPayment  DebtPayment?

  @@unique([subscriptionId, renewalPeriod])
  @@index([userId, type, transactionDate])
  @@index([userId, accountId, deletedAt])
  @@index([userId, currency, deletedAt])
  @@index([debtId])
  @@index([subscriptionId])
  @@index([transferId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  name                 String
  provider             String
  logoUrl              String?
  price                Decimal            @db.Decimal(19, 4)
  currency             String
  billingFrequency     BillingFrequency
  customIntervalDays   Int?
  startDate            DateTime
  nextRenewalDate      DateTime
  endDate              DateTime?
  accountId            String
  paymentMethod        PaymentMethod?
  categoryId           String?
  status               SubscriptionStatus @default(ACTIVE)
  autoRenew            Boolean            @default(true)
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?

  user         User             @relation(fields: [userId], references: [id])
  account      FinancialAccount @relation(fields: [accountId], references: [id])
  category     Category?        @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@index([userId, status, deletedAt])
  @@index([userId, nextRenewalDate, deletedAt])
  @@index([userId, currency, deletedAt])
  @@index([accountId])
  @@index([categoryId])
}

model Debt {
  id                 String             @id @default(cuid())
  userId             String
  accountId          String?
  personName         String
  direction          DebtDirection
  originalAmount     Decimal            @db.Decimal(19, 4)
  remainingAmount    Decimal            @db.Decimal(19, 4)
  currency           String
  exchangeRate       Decimal            @db.Decimal(24, 12)
  baseAmountUsd      Decimal            @db.Decimal(19, 4)
  exchangeRateAt     DateTime
  exchangeRateSource ExchangeRateSource
  dueDate            DateTime?
  status             DebtStatus         @default(OPEN)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  user         User              @relation(fields: [userId], references: [id])
  account      FinancialAccount? @relation(fields: [accountId], references: [id])
  payments     DebtPayment[]
  transactions Transaction[]

  @@index([userId, status, deletedAt])
  @@index([userId, direction, deletedAt])
}

/// Account-to-account fund movement. Principal is NOT income/expense.
/// Only COMPLETED transfers affect balances; fee expenses are optional separate Transactions.
model Transfer {
  id                         String         @id @default(cuid())
  userId                     String
  fromAccountId              String
  toAccountId                String
  sourceAmount               Decimal        @db.Decimal(19, 4)
  sourceCurrency             String
  destinationAmount          Decimal        @db.Decimal(19, 4)
  destinationCurrency        String
  /// Provider-format units of a currency per 1 USD when applicable; 1 for same-currency
  suggestedExchangeRate      Decimal?       @db.Decimal(24, 12)
  /// Achieved rate frozen at save (same-currency = 1; USD pairs = non-USD per 1 USD)
  effectiveExchangeRate      Decimal        @db.Decimal(24, 12)
  suggestedDestinationAmount Decimal?       @db.Decimal(19, 4)
  sourceBaseAmountUsd        Decimal        @db.Decimal(19, 4)
  destinationBaseAmountUsd   Decimal        @db.Decimal(19, 4)
  feeAmount                  Decimal        @default(0) @db.Decimal(19, 4)
  feeCurrency                String?
  feeBaseAmountUsd           Decimal?       @db.Decimal(19, 4)
  /// When true, fee creates a Transfer Fees EXPENSE on the source account (in addition to sourceAmount)
  feePaidSeparately          Boolean        @default(false)
  status                     TransferStatus  @default(PENDING)
  transferredAt              DateTime
  reference                  String?
  notes                      String?
  idempotencyKey             String?
  completedAt                DateTime?
  reversedAt                 DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  deletedAt                  DateTime?

  user        User             @relation(fields: [userId], references: [id])
  fromAccount FinancialAccount @relation("TransferFromAccount", fields: [fromAccountId], references: [id])
  toAccount   FinancialAccount @relation("TransferToAccount", fields: [toAccountId], references: [id])
  feeTransactions Transaction[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status, deletedAt])
  @@index([userId, transferredAt, deletedAt])
  @@index([fromAccountId, status, deletedAt])
  @@index([toAccountId, status, deletedAt])
}

model DebtPayment {
  id                 String             @id @default(cuid())
  debtId             String
  amount             Decimal            @db.Decimal(19, 4)
  currency           String
  exchangeRate       Decimal            @db.Decimal(24, 12)
  baseAmountUsd      Decimal            @db.Decimal(19, 4)
  exchangeRateAt     DateTime
  exchangeRateSource ExchangeRateSource
  paymentDate        DateTime
  notes              String?
  transactionId      String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  debt        Debt         @relation(fields: [debtId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([debtId, deletedAt])
}

model Attachment {
  id             String               @id @default(cuid())
  userId         String
  entityType     AttachmentEntityType
  entityId       String
  provider       StorageProvider      @default(LOCAL)
  storageKey     String
  fileName       String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, storageKey])
  @@index([userId, entityType, entityId, deletedAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  action     AuditAction
  beforeJson Json?
  afterJson  Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, entityType, entityId, createdAt])
  @@index([userId, createdAt])
}
