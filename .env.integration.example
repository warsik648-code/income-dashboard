# Isolated integration-test database credentials.
# Copy to .env.integration and fill in values from the Supabase project
# "income-dashboard-test" (Settings → Database).
#
# NEVER put production credentials here.
# NEVER copy these values into DATABASE_URL in .env.
# This file is gitignored via .env.*

# Pooler URL (used by the app Prisma client during integration tests)
TEST_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&integration_test=1"

# Direct (non-pooler) URL — preferred for prisma migrate deploy
TEST_DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?integration_test=1"

# Optional: set to the test project ref if you cannot add ?integration_test=1
# INTEGRATION_TEST_DB_MARKER="your-test-project-ref"
